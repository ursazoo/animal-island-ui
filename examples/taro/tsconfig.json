{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["@tarojs/taro", "node"],
        "resolveJsonModule": true
    },
    "include": ["src", "config"]
}
